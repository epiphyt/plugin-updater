{
	"name": "epiphyt/wp-plugin-updater",
	"description": "Update and license handling for commercial WordPress plugins distributed via a custom update server.",
	"type": "library",
	"keywords": [
		"wordpress",
		"plugin updates",
		"license",
		"updater"
	],
	"homepage": "https://epiph.yt/en/",
	"license": "GPL-2.0-only",
	"require": {
		"php": "^8.1"
	},
	"require-dev": {
		"brain/monkey": "2.*",
		"epiphyt/coding-standard": "^1.1.1",
		"php-stubs/wordpress-stubs": "^6.8",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpunit/phpunit": "^12.4",
		"szepeviktor/phpstan-wordpress": "^2.0"
	},
	"autoload": {
		"classmap": [
			"inc"
		]
	},
	"autoload-dev": {
		"classmap": [
			"tests/doubles"
		]
	},
	"scripts": {
		"phpcs": "phpcs -s .",
		"phpstan": "phpstan analyse -v --memory-limit=2G",
		"phpunit": "phpunit",
		"test": [
			"@phpcs",
			"@phpstan",
			"@phpunit"
		],
		"test:e2e": "php tests/e2e/run.php --matrix=all",
		"test:e2e:single": "php tests/e2e/run.php --matrix=single",
		"test:e2e:multisite": "php tests/e2e/run.php --matrix=multisite"
	},
	"support": {
		"email": "hey.composer@epiph.yt"
	},
	"authors": [
		{
			"name": "Matthias Kittsteiner",
			"email": "matze.composer@epiph.yt",
			"homepage": "https://kittsteiner.blog",
			"role": "Developer"
		}
	],
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"sort-packages": true
	}
}
