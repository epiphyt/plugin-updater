<?xml version="1.0"?>
<ruleset name="Advanced Set">
	<rule ref="EpiphytCodingStandard">
		<!--
			The standard enables both RequireConstructorPropertyPromotion and
			DisallowConstructorPropertyPromotion, which contradict each other.
			All existing Epiphyt code uses non-promoted typed properties, so
			exclude the sniff requiring promotion to make the choice explicit.
		-->
		<exclude name="SlevomatCodingStandard.Classes.RequireConstructorPropertyPromotion"/>
	</rule>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_supported_wp_version" value="6.5"/>

	<!--
		This package intentionally has no text domain of its own. All
		user-facing strings are translated by the host plugin and injected via
		the Strings value object, so there is no WordPress.WP.I18n text_domain
		configuration here on purpose.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="epiphyt"/>
			</property>
		</properties>
	</rule>

	<exclude-pattern>/tests/e2e/fixtures/*</exclude-pattern>
</ruleset>
